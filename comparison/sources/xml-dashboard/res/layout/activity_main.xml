<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/dashboard_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#f5f7fc">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<FrameLayout android:layout_width="match_parent" android:layout_height="88dp" android:background="#1e3a8a" android:padding="16dp" android:layout_marginBottom="16dp">
<TextView android:id="@+id/dashboard_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Painel de solicitações" android:textSize="22sp" android:textStyle="bold" android:textColor="#ffffff" android:layout_gravity="top" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Central interna · Android XML" android:textSize="13sp" android:textColor="#dbeafe" android:layout_gravity="bottom|left" />
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:orientation="horizontal" android:layout_marginBottom="12dp"><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="6dp" android:background="#ffffff" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textSize="12sp" android:textColor="#667085"/><TextView android:id="@+id/metric_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="28sp" android:textStyle="bold" android:textColor="#202124"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="6dp" android:background="#ffffff" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pendentes" android:textSize="12sp" android:textColor="#667085"/><TextView android:id="@+id/metric_pending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textSize="28sp" android:textStyle="bold" android:textColor="#202124"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="6dp" android:background="#ffffff" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adicionadas" android:textSize="12sp" android:textColor="#667085"/><TextView android:id="@+id/metric_added" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="28sp" android:textStyle="bold" android:textColor="#202124"/></LinearLayout></LinearLayout>
<TextView android:id="@+id/progress_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conclusão · 33%" android:textSize="13sp" android:layout_marginBottom="4dp"/>
<ProgressBar android:id="@+id/completion" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progress="33" android:indeterminate="false" android:progressTint="#315ce8" android:layout_marginBottom="12dp"/>
<EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Buscar solicitação" android:inputType="text" android:singleLine="true" android:textSize="16sp" android:padding="12dp" android:background="#ffffff"/>
<Switch android:id="@+id/only_pending" android:layout_width="match_parent" android:layout_height="48dp" android:text="Só pendentes" android:textSize="14sp" android:checked="false" android:layout_marginBottom="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#ffffff" android:padding="16dp" android:layout_marginBottom="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Criar solicitação" android:textSize="18sp" android:textStyle="bold"/>
<EditText android:id="@+id/draft_title" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Nome da solicitação" android:text="Acesso ao ambiente" android:inputType="textCapSentences" android:singleLine="true" android:textSize="16sp" android:padding="10dp" android:background="#f5f7fc" android:layout_marginTop="8dp"/>
<CheckBox android:id="@+id/urgent" android:layout_width="match_parent" android:layout_height="48dp" android:text="Urgente" android:checked="false" android:textSize="14sp"/>
<Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="48dp" android:text="Salvar solicitação" android:textAllCaps="false"/>
<TextView android:id="@+id/form_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Informe um título com 3 caracteres." android:textSize="12sp" android:textColor="#667085"/>
</LinearLayout>
<TextView android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3 resultados" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
<LinearLayout android:id="@+id/card_access" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="#ffffff" android:layout_marginBottom="12dp" android:visibility="visible"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acesso" android:textSize="12sp" android:textColor="#667085"/><TextView android:id="@+id/title_access" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seed_access" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="6dp"/><TextView android:id="@+id/status_access" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pendente" android:textSize="14sp" android:layout_marginTop="8dp"/><Button android:id="@+id/open_access" android:layout_width="match_parent" android:layout_height="48dp" android:text="Abrir detalhe" android:textAllCaps="false" android:layout_marginTop="8dp"/></LinearLayout>
<LinearLayout android:id="@+id/card_equipment" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="#ffffff" android:layout_marginBottom="12dp" android:visibility="visible"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compras" android:textSize="12sp" android:textColor="#667085"/><TextView android:id="@+id/title_equipment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seed_equipment" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="6dp"/><TextView android:id="@+id/status_equipment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pendente · Urgente" android:textSize="14sp" android:layout_marginTop="8dp"/></LinearLayout>
<LinearLayout android:id="@+id/card_contract" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="#ffffff" android:layout_marginBottom="12dp" android:visibility="visible"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Jurídico" android:textSize="12sp" android:textColor="#667085"/><TextView android:id="@+id/title_contract" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seed_contract" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="6dp"/><TextView android:id="@+id/status_contract" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Concluída" android:textSize="14sp" android:layout_marginTop="8dp"/></LinearLayout>
<LinearLayout android:id="@+id/card_new" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="#ffffff" android:layout_marginBottom="12dp" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compras" android:textSize="12sp" android:textColor="#667085"/><TextView android:id="@+id/title_new" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nova solicitação" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="6dp"/><TextView android:id="@+id/status_new" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pendente" android:textSize="14sp" android:layout_marginTop="8dp"/><Button android:id="@+id/open_new" android:layout_width="match_parent" android:layout_height="48dp" android:text="Abrir detalhe" android:textAllCaps="false" android:layout_marginTop="8dp"/></LinearLayout>
</LinearLayout></ScrollView>
