  "schemaVersion": 1,
  "compiler": "emcc (Emscripten gcc/clang-like replacement + linker emulating GNU ld) 3.1.74 (1092ec30a3fb1d46b1782ff1b4db5094d3d06ae5)",
  "build": "scripts/build-sqlcipher.sh",
  "surface": "scripts/sqlcipher-surface.mjs (Java classes of the published AARs only; no .so read)",
  "scope": "Lab-built wasm32 libsqlcipher.so modules from SQLCipher public sources and the official Android JNI glue. Never derived from an APK or an AAR binary.",
  "flags": "-DSQLITE_HAS_CODEC -DSQLCIPHER_CRYPTO_LIBTOMCRYPT -DSQLITE_TEMP_STORE=2 -DSQLITE_THREADSAFE=1 -DSQLITE_MUTEX_NOOP -DOMIT_MEMLOCK -DSQLITE_OS_OTHER=1 -DNDEBUG -DLTC_NO_FILE -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_FTS3_PARENTHESIS -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS4_UNICODE61 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_MEMORY_MANAGEMENT -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_RTREE -DSQLITE_SOUNDEX -DHAVE_USLEEP -DSQLITE_ENABLE_LOAD_EXTENSION -DSQLITE_ENABLE_STAT3 -DSQLITE_ENABLE_STAT4 -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_EXPLAIN_COMMENTS -DSQLITE_DEFAULT_WAL_SYNCHRONOUS=1 -DSQLITE_MAX_VARIABLE_NUMBER=99999 -DSQLITE_DEFAULT_JOURNAL_SIZE_LIMIT=1048576 -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_USE_URI",
  "linkFlags": "-fPIC (all objects) -O2 -sSIDE_MODULE=1 -sWASM_BIGINT=1 -fwasm-exceptions -Wl,--gc-sections, linked against libc++_shared.so; DT_NEEDED libc++_shared.so",
  "labGlue": [
    "scripts/wasm/sqlcipher-host.c (SQLite VFS over the lab VirtualFileSystem, liblog, entropy hook, GNU strerror_r shim)",
    "scripts/wasm/sqlcipher/android/log.h",
    "scripts/wasm/sqlcipher/apkweb-glue-compat.h"
  ],
  "entropy": "LibTomCrypt rng_get_bytes() consults ltc_rng (-DLTC_PRNG_ENABLE_LTC_RNG), which the module points at host_random = crypto.getRandomValues in src/sqlcipher-native.js; sqlite3_randomness uses the VFS xRandomness = the same import. No clock- or seed-derived fallback is reachable: the host import throws when WebCrypto is unavailable.",
  "deviations": [
    "SQLITE_THREADSAFE=1 with SQLITE_MUTEX_NOOP (single-threaded wasm; SQLCipher refuses THREADSAFE=0)",
    "SQLITE_OS_OTHER with a VFS over the lab virtual filesystem and in-process WAL-index shared memory (no mmap, no POSIX locks)",
    "OMIT_MEMLOCK (no mlock in wasm)",
    "-Dsection(x)= when compiling the 4.19.0 amalgamation: drops its .fini_array shutdown registration, which WebAssembly objects cannot carry",
    "the 4.5.4 legacy module uses LibTomCrypt instead of OpenSSL (see index.json crypto.note)",
    "SQLITE_ENABLE_LOAD_EXTENSION is kept for glue compatibility; dlopen is unavailable in wasm so loading an extension fails with the library error"
  ],
